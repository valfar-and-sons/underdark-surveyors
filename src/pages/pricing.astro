---
import BaseLayout from "../layouts/BaseLayout.astro";
import GlassCard from "../components/GlassCard.astro";
---

<BaseLayout
  title="Pricing — Loremaster"
  description="Loremaster pricing plans for tabletop RPG campaign management."
>
  <div class="mx-auto grid max-w-[1200px] gap-7 px-[clamp(16px,4vw,28px)] py-8 md:py-12">
    <GlassCard accentBar class="p-[clamp(1.5rem,1rem+2vw,2.5rem)]">
      <h1 class="text-[clamp(1.7rem,1.2rem+2vw,2.5rem)] font-bold">Pricing</h1>
      <div class="gold-divider my-5"></div>
      <p class="voice max-w-[70ch] text-[clamp(1rem,0.95rem+0.3vw,1.15rem)]">
        Pricing details are coming soon. In the meantime, you can try Loremaster for free.
      </p>
      <div class="mt-6">
        <a
          class="inline-flex items-center rounded-[10px] bg-accent px-5 py-3 text-[15px] font-semibold text-[#1a1520] no-underline transition-all duration-200 hover:-translate-y-px hover:bg-accent-hover hover:shadow-[0_8px_24px_rgba(218,160,64,0.2)]"
          href="https://loremaster.valfarandsons.com"
        >
          Try Loremaster free
        </a>
      </div>
    </GlassCard>
  </div>
</BaseLayout>
