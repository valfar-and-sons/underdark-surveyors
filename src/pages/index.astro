---
import BaseLayout from "../layouts/BaseLayout.astro";
import GlassCard from "../components/GlassCard.astro";
import FeatureCard from "../components/FeatureCard.astro";
import HeroSessionCarousel from "../components/HeroSessionCarousel.astro";
---

<BaseLayout title="Loremaster — AI Campaign Tracker for D&D & TTRPGs" description="Loremaster records your D&D and TTRPG sessions, generates cinematic recaps, tracks NPCs and locations, and lets you chat with AI about your campaign. Try it free with your group." jsonLd={{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Loremaster",
  "applicationCategory": "GameApplication",
  "operatingSystem": "Web",
  "description": "AI-powered platform for tabletop RPG campaign management. Session recaps, world tracking, and campaign chat for D&D and TTRPG groups.",
  "url": "https://www.askloremaster.com",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD",
    "availability": "https://schema.org/LimitedAvailability"
  }
}}>
  <div class="mx-auto max-w-[1200px] px-[clamp(16px,4vw,28px)]">
    <!-- Hero (centered, open) -->
    <section class="relative mx-auto max-w-[780px] py-20 text-center md:py-32">
      <!-- Ambient glow (box-shadow for smooth rendering) -->
      <div
        class="pointer-events-none absolute left-1/2 top-1/2 -z-10 h-0 w-0 -translate-x-1/2 -translate-y-1/2"
        style="box-shadow: 0 0 200px 120px rgba(218, 160, 64, 0.035), 0 0 400px 200px rgba(218, 160, 64, 0.02);"
      ></div>
      <h1 class="voice-gradient text-[clamp(2.5rem,1.5rem+5vw,4.5rem)] font-bold leading-[1.1]" style="font-family: var(--font-voice-display); font-style: italic; opacity: 0; animation: heroIn 0.8s ease-out 100ms forwards, voiceShimmer 5s linear infinite;">
        Stop taking notes.<br />Stay in the story.
      </h1>
      <p class="hero-cascade mx-auto mt-6 max-w-[50ch] text-[clamp(1.15rem,1rem+0.5vw,1.4rem)] leading-relaxed text-text-body">
        Play your campaign while Loremaster generates a cinematic recap and tracks your adventures, session after session.
      </p>
      <div class="hero-cascade mt-10">
        <a
          class="inline-flex items-center gap-2.5 rounded-xl bg-accent px-10 py-[18px] text-[18px] font-semibold text-[#1a1520] no-underline transition-all duration-200 hover:-translate-y-px hover:bg-accent-hover hover:shadow-[0_4px_28px_rgba(218,160,64,0.25)]"
          href="https://app.askloremaster.com/sign-up"
        >
          Try Loremaster Free
        </a>
      </div>
      <p class="hero-cascade mt-4 text-[14px] text-text-muted">Free for 60 days. No card required.</p>
    </section>

    <!-- Hero Session Carousel -->
    <div class="reveal">
      <HeroSessionCarousel />
    </div>

    <div class="section-connector my-12 md:my-16"></div>

    <!-- Why Loremaster? (full-bleed, no card) -->
    <section class="reveal mx-auto max-w-[680px] py-12 text-center md:py-20">
      <h2 class="text-[clamp(1.6rem,1.2rem+2vw,2.4rem)]">Why Loremaster?</h2>
      <div class="gold-divider-animated mx-auto mt-4 mb-8"></div>
      <p class="mb-5 text-[clamp(1.1rem,1rem+0.5vw,1.3rem)] leading-[1.8] text-text-body">
        Keeping track of everything in a campaign takes work. What exactly happened last time? Who was that NPC? What did the party promise to do? All of it pulls you out of the moment.
      </p>
      <p class="voice text-[clamp(1.1rem,1rem+0.5vw,1.3rem)]">
        Loremaster keeps track of your world, so players can stay focused on what matters most: telling stories together.
      </p>
    </section>

    <div class="section-connector my-12 md:my-16"></div>

    <!-- Loremaster Voice quote -->
    <div class="reveal mx-auto max-w-[720px]">
      <div
        class="relative overflow-hidden rounded-[14px] backdrop-blur-[12px]"
        style="background: var(--lm-card-glass); border: 1px solid var(--lm-card-border); border-top: 1px solid var(--lm-card-border-top); padding: 28px 32px 32px 24px;"
      >
        <div
          class="absolute left-0 top-0 bottom-0 w-[4px]"
          style="background: var(--lm-accent-bar); border-radius: 14px 0 0 14px;"
        ></div>
        <p
          class="voice-gradient text-[clamp(1.15rem,1rem+0.8vw,1.5rem)] leading-[1.75]"
          style="font-family: var(--font-voice); font-style: italic;"
        >
          <span
            class="voice-gradient float-left font-bold"
            style="font-family: var(--font-voice-display); font-style: normal; font-size: 3.65em; line-height: 0.85; margin-right: 0.08em; margin-top: 0.06em;"
          >T</span>he salt air has a way of binding strangers together. After a heavy night in Saltmarsh, Migli, Durn, and Joren faced a goblin ambush on the road to Seagrove. Though blood was spilled and Migli nearly fell, they stood their ground, learning quickly that the path ahead demands more than just shared gold.
        </p>
      </div>
      <p class="mt-4 text-center text-[14px] text-text-muted">
        Generated by Loremaster from a real session
      </p>
    </div>

    <div class="section-connector my-12 md:my-16"></div>

    <!-- How it works (vertical timeline, full-bleed) -->
    <section class="reveal mx-auto max-w-[660px] py-12 md:py-16">
      <h2 class="text-center text-[clamp(1.6rem,1.2rem+2vw,2.4rem)]">How it works</h2>
      <div class="gold-divider-animated mx-auto mt-4 mb-12"></div>
      <div class="reveal-stagger relative grid gap-0">
        <!-- Timeline line -->
        <div
          class="absolute left-[25px] top-[4px] bottom-[4px] w-px md:left-[27px]"
          style="background: linear-gradient(to bottom, var(--lm-accent), rgba(218, 160, 64, 0.1));"
        ></div>

        <!-- Step 1 -->
        <div class="reveal relative flex gap-7 pb-14 pl-1">
          <div class="relative z-10 flex h-[51px] w-[51px] shrink-0 items-center justify-center rounded-full border border-accent bg-[#0a090c] text-[20px] text-accent md:h-[55px] md:w-[55px] md:text-[22px]" style="font-family: var(--font-voice); font-style: italic;">
            1
          </div>
          <div class="pt-2.5">
            <h3 class="mb-2.5 text-[22px] font-semibold text-text-primary md:text-[24px]">Play your session</h3>
            <p class="text-[17px] leading-relaxed text-text-body md:text-[18px]">Record or upload however you want. Audio, notes, transcripts: it all works.</p>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="reveal relative flex gap-7 pb-14 pl-1">
          <div class="relative z-10 flex h-[51px] w-[51px] shrink-0 items-center justify-center rounded-full border border-accent bg-[#0a090c] text-[20px] text-accent md:h-[55px] md:w-[55px] md:text-[22px]" style="font-family: var(--font-voice); font-style: italic;">
            2
          </div>
          <div class="pt-2.5">
            <h3 class="mb-2.5 text-[22px] font-semibold text-text-primary md:text-[24px]">Get a recap</h3>
            <p class="text-[17px] leading-relaxed text-text-body md:text-[18px]">Loremaster generates a cinematic summary, pulls out key events, and starts building your world.</p>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="reveal relative flex gap-7 pl-1">
          <div class="relative z-10 flex h-[51px] w-[51px] shrink-0 items-center justify-center rounded-full border border-accent bg-[#0a090c] text-[20px] text-accent md:h-[55px] md:w-[55px] md:text-[22px]" style="font-family: var(--font-voice); font-style: italic;">
            3
          </div>
          <div class="pt-2.5">
            <h3 class="mb-2.5 text-[22px] font-semibold text-text-primary md:text-[24px]">Pick up where you left off</h3>
            <p class="text-[17px] leading-relaxed text-text-body md:text-[18px]">Start your next session with everything fresh, or ask about anything that's happened so far.</p>
          </div>
        </div>
      </div>
    </section>

    <div class="section-connector my-12 md:my-16"></div>

    <!-- Feature Highlights (staggered) -->
    <section class="py-12 md:py-16">
      <h2 class="reveal text-center text-[clamp(1.6rem,1.2rem+2vw,2.4rem)]">Fits right into your game</h2>
      <div class="gold-divider-animated mx-auto mt-4 mb-12"></div>
      <div class="reveal-stagger grid gap-6 lg:grid-cols-3">
        <div class="reveal">
          <FeatureCard
            title="Relive every session"
            description="Upload a recording or transcript and get a cinematic recap, key events, and scene illustrations you can actually read and share."
          >
            <svg slot="icon" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true" style="transform: translateY(1px);">
              <path d="M57.594 43v242.563l80 30.53V292c-22.504-3.217-45.065-8.633-62.53-26.844l13.5-12.937c12.15 12.667 29.032 17.263 48.28 20.374L110.656 55.03C93.3 51.725 75.492 48.1 57.594 43zm397.125.03c-65.178 17.392-138.354.102-191.22 70.814v208.812c19.795-29.15 45.443-40.866 70.72-46.53 33.914-7.603 66.18-7.163 91.5-27.626l11.75 14.53c-31.256 25.263-68.25 24.386-99.158 31.314-29.295 6.566-53.978 17.63-72.25 63.187l188.657-71.967V43.03zM128.81 49.28l27.407 228.157.06.563V494.906l19.94-39.28 20.468 38.155V296.814L168.563 57.5l-39.75-8.22zm60.47 24.25l25.593 217.782c4.175 2.3 8.258 4.96 12.188 8.063 6.452 5.097 12.412 11.36 17.75 18.97V109.5c-15.496-17.475-34.402-28.327-55.532-35.97zM20.5 74.376v239.813l6.125 2.25 110.97 40.78v-19.906l-98.407-36.156V74.376H20.5zm452.594.03v226.75l-216.938 79.69-40.78-14.97v38.28c23.21 8.03 58.078 6.813 86.25-2.53v-17.563l184.03-67.625 6.125-2.25V74.407h-18.686zm-257.72 239.532v31.813l27.564 10.53c-7.04-20.847-16.565-33.66-27.438-42.25-.04-.03-.084-.06-.125-.092z"/>
            </svg>
          </FeatureCard>
        </div>
        <div class="reveal">
          <FeatureCard
            title="Nothing gets forgotten"
            description="Characters, locations, and artifacts are captured as you play. Loremaster finds new entities and suggests updates without manual work."
          >
            <svg slot="icon" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true">
              <path d="M322.02 20.184l-17.13 42.273c7.053 2.776 13.857 6.04 20.372 9.758l8.62-13.274 15.675 10.18-8.637 13.296c.85.628 1.692 1.266 2.53 1.91l-19.745 22.735c4.994 3.747 9.706 7.85 14.1 12.268l19.754-22.746c.187.184.38.366.567.55l11.795-10.618 12.504 13.89-11.79 10.614c4.71 5.887 9.005 12.117 12.846 18.648l14.114-7.19 8.482 16.653-14.092 7.177c3.015 6.877 5.555 14.007 7.578 21.353l15.452-3.283 3.884 18.28-15.445 3.282c1.114 7.374 1.71 14.918 1.77 22.59l15.777.827-.98 18.664-15.74-.825c-.835 7.61-2.214 15.056-4.09 22.303l14.947 4.857-5.777 17.774-14.922-4.85c-2.767 7.09-6.03 13.934-9.75 20.486l13.142 8.537-10.18 15.674-13.13-8.528c-4.493 6.108-9.418 11.877-14.725 17.273l10.46 11.617-13.89 12.506-10.437-11.594c-5.9 4.734-12.14 9.062-18.69 12.924l7.05 13.838-16.65 8.484-7.033-13.803c-6.898 3.034-14.055 5.585-21.427 7.62l3.213 15.123-18.28 3.884-3.21-15.107c-7.405 1.125-14.978 1.735-22.682 1.797l-.808 15.41-18.662-.98.807-15.368c-7.645-.834-15.127-2.208-22.405-4.092l-4.738 14.58-17.773-5.777 4.73-14.55c-7.124-2.78-13.997-6.063-20.575-9.803l-8.328 12.822-15.672-10.18 8.33-12.824c-.93-.685-1.848-1.384-2.762-2.088l19.848-22.853c-4.997-3.743-9.71-7.842-14.108-12.257l-19.848 22.853c-.156-.152-.314-.302-.47-.455l-11.356 10.226-12.504-13.89 11.347-10.216c-4.563-5.7-8.737-11.725-12.49-18.03l-38.9 23.71c9.515 15.894 21.132 30.386 34.472 43.088l-20.575 23.69 14.112 12.255 20.575-23.693c34.76 27.522 78.7 43.96 126.482 43.96 1.365 0 2.726-.023 4.084-.05v19.473c-34.134 15.356-59.115 36.682-79.753 59.906h197.54c-19.674-24.32-44.835-43.993-80.784-59.712V409.41c92.908-19.004 162.8-101.184 162.8-199.68 0-58.094-24.315-110.51-63.323-147.636l20.58-23.698-14.11-12.253-20.584 23.7c-15.464-12.24-32.75-22.278-51.376-29.66zm-75.108 82.664c-59.132 0-106.838 47.692-106.838 106.8 0 59.11 47.706 106.8 106.838 106.8 59.132 0 106.838-47.69 106.838-106.8 0-9.375-1.203-18.462-3.46-27.12-10.244 25.087-23.08 45.15-45.905 66.95-16.887-1.487-29.712-8.08-40.643-19.966 6.048-8.86 13.09-17.22 27.096-22.102-12.564-28.283-18.19-56.568-21.393-84.85 12.464 4.59 20.16 11.93 29.235 24.954 7.712 1.697 16.863-6.856 23.27-13.975-19.274-18.99-45.752-30.692-75.038-30.692zm-32.48 65.03c17.62 12.56 32.407 31.486 38.03 52.517-11.065 9.256-16.907 21.124-19.92 34.406 16.957 8.23 30.048 21.297 41.65 36.22v.007c-34.438-3.405-68.245-9.135-98.696-27.164-12.172-20.824-19.107-41.65-19.92-62.474 16.6-7.525 33.2-4.936 49.8.895 9.222-11.47 9.186-20.922 9.056-34.408z"/>
            </svg>
          </FeatureCard>
        </div>
        <div class="reveal">
          <FeatureCard
            title="Never lose the thread"
            description="Ask anything about your campaign and get answers grounded in what actually happened, from last session to the very beginning."
          >
            <svg slot="icon" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true">
              <path d="M470.7 20L368.2 49.81l41.5-28.09c-26.2 5.92-59.3 17.5-100.9 36.19l-67.9 70.79L265 79.25c-23.3 12.96-48 29.95-71.8 49.85l-15.8 64.3-3.4-47.6c-23.5 21.6-45.6 45.6-63.9 70.9-19.23 26.5-34.26 54.5-41.79 82.4l-28.12-18.8c2.52 23.7 10.31 44.3 23.09 63.2l-33.62-10.3c7.64 23.5 20.13 38.7 41.25 51-11.83 33.3-17.38 68.1-23.34 102.8l18.4 3.1C87.31 277.4 237.9 141.8 374 81.72l6.9 17.38c-121.7 54.5-216.3 146.5-265.8 279.1 18.1.1 35.8-2.1 52.2-6.3l4.9-60.9 13.1 55.5c10.9-4 20.9-8.8 29.8-14.4l-20.7-43.5 32.8 34.8c8-6.4 14.6-13.6 19.6-21.5 30.4-47.5 62.2-94.7 124.8-134.2l-45.7-16.2 70.1 2.1c11.4-5.8 23.4-12.9 32.5-19.6l-49.7-4 74.7-17.6c5.8-5.8 11.2-11.9 16.1-18 17.3-21.94 29-44.78 26.2-65.55-1.3-10.39-7.5-20.16-17.6-25.63-2.5-1.3-5.2-2.45-7.5-3.22z"/>
            </svg>
          </FeatureCard>
        </div>
      </div>
      <p class="mt-7 text-center">
        <a
          href="/product"
          class="text-[15px] font-medium text-accent no-underline transition-opacity hover:opacity-80"
        >
          See all features &rarr;
        </a>
      </p>
    </section>

    <div class="section-connector my-12 md:my-16"></div>

    <!-- CTA Banner -->
    <div class="reveal pb-16 md:pb-24">
      <GlassCard class="p-[clamp(2.5rem,2rem+2vw,4rem)] text-center">
        <h2 class="text-[clamp(1.6rem,1.2rem+2vw,2.4rem)]">Want to try Loremaster?</h2>
        <p class="mx-auto mt-4 max-w-[50ch] text-[17px] text-text-body">
          Start free with your group today. Questions first? Reach out and we'll help you get set up.
        </p>
        <div class="mt-8">
          <a
            class="inline-flex items-center rounded-xl bg-accent px-10 py-[18px] text-[18px] font-semibold text-[#1a1520] no-underline transition-all duration-200 hover:-translate-y-px hover:bg-accent-hover hover:shadow-[0_4px_28px_rgba(218,160,64,0.25)]"
            href="https://app.askloremaster.com/sign-up"
          >
            Try Loremaster Free
          </a>
        </div>
      </GlassCard>
    </div>
  </div>
</BaseLayout>
