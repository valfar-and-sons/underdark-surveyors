---
import BaseLayout from "../layouts/BaseLayout.astro";
import GlassCard from "../components/GlassCard.astro";
import FeatureCard from "../components/FeatureCard.astro";
---

<BaseLayout title="Loremaster — AI Tools for Tabletop Storytelling">
  <div class="mx-auto grid max-w-[1200px] gap-7 px-[clamp(16px,4vw,28px)] py-8 md:py-12">
    <!-- Hero -->
    <GlassCard accentBar class="p-[clamp(1.5rem,1rem+2vw,2.5rem)]">
      <h1 class="text-[clamp(1.7rem,1.2rem+2vw,2.5rem)] font-bold">
        Using AI to keep storytelling human.
      </h1>
      <div class="gold-divider my-5"></div>
      <p class="voice max-w-[70ch] text-[clamp(1rem,0.95rem+0.3vw,1.15rem)]">
        <em class="voice-shimmer not-italic">An AI-powered creative companion for tabletop campaigns.</em>
      </p>
      <p class="voice max-w-[70ch] text-[clamp(1rem,0.95rem+0.3vw,1.15rem)]">
        Loremaster helps game masters and players stay in the moment,
        remember what matters, and tell richer stories together.
      </p>
      <div class="mt-6">
        <a
          class="inline-flex items-center rounded-[10px] bg-accent px-5 py-3 text-[15px] font-semibold text-[#1a1520] no-underline transition-all duration-200 hover:-translate-y-px hover:bg-accent-hover hover:shadow-[0_8px_24px_rgba(218,160,64,0.2)]"
          href="https://loremaster.valfarandsons.com"
        >
          Try Loremaster
        </a>
      </div>
    </GlassCard>

    <!-- Hero Screenshot -->
    <div
      class="overflow-hidden rounded-[14px] border border-card-border"
      style="background: var(--lm-card-glass);"
    >
      <!-- Replace with a full-width campaign dashboard screenshot -->
      <div class="flex aspect-[16/9] items-center justify-center">
        <span class="text-[14px] text-text-faint">Screenshot coming soon</span>
      </div>
    </div>

    <!-- About (brief) -->
    <GlassCard class="p-[clamp(1.25rem,0.9rem+1.6vw,2.25rem)]">
      <h2 class="text-[clamp(1.2rem,1rem+1.2vw,1.6rem)]">Why Loremaster?</h2>
      <div class="gold-divider my-4"></div>
      <p class="mb-3 max-w-[70ch] text-[clamp(1rem,0.98rem+0.25vw,1.1rem)] text-text-body">
        Campaigns are living stories, but managing them often feels like bookkeeping. Taking notes,
        tracking NPCs, and remembering open plot lines can pull focus away from the story itself.
      </p>
      <p class="voice max-w-[70ch] text-[clamp(1rem,0.98rem+0.25vw,1.1rem)]">
        Loremaster is an AI-assisted platform that keeps the story straight, offers flavorful
        exposition when you need it, and helps players stay focused on what matters most: telling
        stories together.
      </p>
    </GlassCard>

    <!-- Feature Highlights -->
    <section>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <FeatureCard
          icon="🎙️"
          title="Session to story"
          description="Upload a recording or transcript. Get narrative summaries, key events, and AI-generated scene illustrations back."
        />
        <FeatureCard
          icon="📖"
          title="The Codex"
          description="Every character, location, and artifact tracked automatically. Loremaster finds new entities and suggests additions as you play."
        />
        <FeatureCard
          icon="💬"
          title="Ask Loremaster"
          description="Chat with an AI that knows your entire campaign. Get recaps, look up details, or brainstorm where the story goes next."
        />
      </div>
      <p class="mt-5 text-center">
        <a
          href="/product"
          class="text-[14px] font-medium text-accent no-underline transition-opacity hover:opacity-80"
        >
          See all features &rarr;
        </a>
      </p>
    </section>

    <!-- CTA Banner -->
    <GlassCard class="p-[clamp(1.5rem,1rem+2vw,2.5rem)] text-center">
      <h2 class="text-[clamp(1.2rem,1rem+1.2vw,1.6rem)]">Ready to tell richer stories?</h2>
      <p class="mx-auto mt-2 max-w-[50ch] text-text-body">
        Join players and game masters who use Loremaster to focus on what matters most.
      </p>
      <div class="mt-5">
        <a
          class="inline-flex items-center rounded-[10px] bg-accent px-5 py-3 text-[15px] font-semibold text-[#1a1520] no-underline transition-all duration-200 hover:-translate-y-px hover:bg-accent-hover hover:shadow-[0_8px_24px_rgba(218,160,64,0.2)]"
          href="https://loremaster.valfarandsons.com"
        >
          Try Loremaster
        </a>
      </div>
    </GlassCard>
  </div>
</BaseLayout>
