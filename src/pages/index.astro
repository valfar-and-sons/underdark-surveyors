---
import BaseLayout from "../layouts/BaseLayout.astro";
import GlassCard from "../components/GlassCard.astro";
import FeatureCard from "../components/FeatureCard.astro";
import HeroSessionCarousel from "../components/HeroSessionCarousel.astro";
---

<BaseLayout title="Loremaster — AI Tools for Tabletop Storytelling">
  <div class="mx-auto max-w-[1200px] px-[clamp(16px,4vw,28px)]">
    <!-- Hero (centered, open) -->
    <section class="relative mx-auto max-w-[780px] py-20 text-center md:py-32">
      <!-- Ambient glow (box-shadow for smooth rendering) -->
      <div
        class="pointer-events-none absolute left-1/2 top-1/2 -z-10 h-0 w-0 -translate-x-1/2 -translate-y-1/2"
        style="box-shadow: 0 0 200px 120px rgba(218, 160, 64, 0.035), 0 0 400px 200px rgba(218, 160, 64, 0.02);"
      ></div>
      <h1 class="voice-gradient text-[clamp(2.5rem,1.5rem+5vw,4.5rem)] font-bold leading-[1.1]" style="font-family: var(--font-voice-display); font-style: italic; opacity: 0; animation: heroIn 0.8s ease-out 100ms forwards, voiceShimmer 5s linear infinite;">
        Stop taking notes.<br />Stay in the story.
      </h1>
      <p class="hero-cascade mx-auto mt-6 max-w-[50ch] text-[clamp(1.15rem,1rem+0.5vw,1.4rem)] leading-relaxed text-text-body">
        Play your campaign while Loremaster generates a cinematic recap and tracks your world, session after session.
      </p>
      <div class="hero-cascade mt-10">
        <a
          class="inline-flex items-center gap-2.5 rounded-xl bg-accent px-10 py-[18px] text-[18px] font-semibold text-[#1a1520] no-underline transition-all duration-200 hover:-translate-y-px hover:bg-accent-hover hover:shadow-[0_4px_28px_rgba(218,160,64,0.25)]"
          href="https://app.askloremaster.com"
        >
          Try Loremaster Free
          <span class="rounded-full bg-[#1a1520]/15 px-2 py-0.5 text-[10px] tracking-wide uppercase">Early Access</span>
        </a>
      </div>
      <p class="hero-cascade mt-4 text-[14px] text-text-muted">Free to start. No credit card required.</p>
    </section>

    <!-- Hero Session Carousel -->
    <div class="reveal">
      <HeroSessionCarousel />
    </div>

    <div class="section-connector my-12 md:my-16"></div>

    <!-- Why Loremaster? (full-bleed, no card) -->
    <section class="reveal mx-auto max-w-[680px] py-12 text-center md:py-20">
      <h2 class="text-[clamp(1.6rem,1.2rem+2vw,2.4rem)]">Why Loremaster?</h2>
      <div class="gold-divider-animated mx-auto mt-4 mb-8"></div>
      <p class="mb-5 text-[clamp(1.1rem,1rem+0.5vw,1.3rem)] leading-[1.8] text-text-body">
        Keeping track of everything in a campaign takes work. What exactly happened last time? Who was that NPC? What did the party promise to do? All of it pulls you out of the moment.
      </p>
      <p class="voice text-[clamp(1.1rem,1rem+0.5vw,1.3rem)]">
        Loremaster keeps track of your world, so players can stay focused on what matters most: telling stories together.
      </p>
    </section>

    <div class="section-connector my-12 md:my-16"></div>

    <!-- Loremaster Voice quote -->
    <div class="reveal mx-auto max-w-[720px]">
      <div
        class="relative overflow-hidden rounded-[14px] backdrop-blur-[12px]"
        style="background: var(--lm-card-glass); border: 1px solid var(--lm-card-border); border-top: 1px solid var(--lm-card-border-top); padding: 28px 32px 32px 24px;"
      >
        <div
          class="absolute left-0 top-0 bottom-0 w-[4px]"
          style="background: var(--lm-accent-bar); border-radius: 14px 0 0 14px;"
        ></div>
        <p
          class="voice-gradient text-[clamp(1.15rem,1rem+0.8vw,1.5rem)] leading-[1.75]"
          style="font-family: var(--font-voice); font-style: italic;"
        >
          The salt air has a way of binding strangers together. After a heavy night in Saltmarsh, Migli, Durn, and Joren faced a goblin ambush on the road to Seagrove. Though blood was spilled and Migli nearly fell, they stood their ground, learning quickly that the path ahead demands more than just shared gold.
        </p>
      </div>
      <p class="mt-4 text-center text-[14px] text-text-muted">
        Generated by Loremaster from a real session
      </p>
    </div>

    <div class="section-connector my-12 md:my-16"></div>

    <!-- How it works (vertical timeline, full-bleed) -->
    <section class="reveal mx-auto max-w-[660px] py-12 md:py-16">
      <h2 class="text-center text-[clamp(1.6rem,1.2rem+2vw,2.4rem)]">How it works</h2>
      <div class="gold-divider-animated mx-auto mt-4 mb-12"></div>
      <div class="reveal-stagger relative grid gap-0">
        <!-- Timeline line -->
        <div
          class="absolute left-[25px] top-[4px] bottom-[4px] w-px md:left-[27px]"
          style="background: linear-gradient(to bottom, var(--lm-accent), rgba(218, 160, 64, 0.1));"
        ></div>

        <!-- Step 1 -->
        <div class="reveal relative flex gap-7 pb-14 pl-1">
          <div class="relative z-10 flex h-[51px] w-[51px] shrink-0 items-center justify-center rounded-full border border-accent bg-[#0a090c] text-[20px] text-accent md:h-[55px] md:w-[55px] md:text-[22px]" style="font-family: var(--font-voice); font-style: italic;">
            1
          </div>
          <div class="pt-2.5">
            <h3 class="mb-2.5 text-[22px] font-semibold text-text-primary md:text-[24px]">Play your session</h3>
            <p class="text-[17px] leading-relaxed text-text-body md:text-[18px]">Record or upload however you want. Audio, notes, transcripts: it all works.</p>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="reveal relative flex gap-7 pb-14 pl-1">
          <div class="relative z-10 flex h-[51px] w-[51px] shrink-0 items-center justify-center rounded-full border border-accent bg-[#0a090c] text-[20px] text-accent md:h-[55px] md:w-[55px] md:text-[22px]" style="font-family: var(--font-voice); font-style: italic;">
            2
          </div>
          <div class="pt-2.5">
            <h3 class="mb-2.5 text-[22px] font-semibold text-text-primary md:text-[24px]">Get a recap</h3>
            <p class="text-[17px] leading-relaxed text-text-body md:text-[18px]">Loremaster generates a cinematic summary, pulls out key events, and starts building your world.</p>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="reveal relative flex gap-7 pl-1">
          <div class="relative z-10 flex h-[51px] w-[51px] shrink-0 items-center justify-center rounded-full border border-accent bg-[#0a090c] text-[20px] text-accent md:h-[55px] md:w-[55px] md:text-[22px]" style="font-family: var(--font-voice); font-style: italic;">
            3
          </div>
          <div class="pt-2.5">
            <h3 class="mb-2.5 text-[22px] font-semibold text-text-primary md:text-[24px]">Pick up where you left off</h3>
            <p class="text-[17px] leading-relaxed text-text-body md:text-[18px]">Start your next session with everything fresh, or ask about anything that's happened so far.</p>
          </div>
        </div>
      </div>
    </section>

    <div class="section-connector my-12 md:my-16"></div>

    <!-- Feature Highlights (staggered) -->
    <section class="py-12 md:py-16">
      <h2 class="reveal text-center text-[clamp(1.6rem,1.2rem+2vw,2.4rem)]">Fits right into your game</h2>
      <div class="gold-divider-animated mx-auto mt-4 mb-12"></div>
      <div class="reveal-stagger grid gap-6 lg:grid-cols-3">
        <div class="reveal">
          <FeatureCard
            title="Relive every session"
            description="Upload a recording or transcript and get a cinematic recap, key events, and scene illustrations you can actually read and share."
          />
        </div>
        <div class="reveal">
          <FeatureCard
            title="Your world, tracked automatically"
            description="Characters, locations, and artifacts are captured as you play. Loremaster finds new entities and suggests updates without manual work."
          />
        </div>
        <div class="reveal">
          <FeatureCard
            title="Never lose the thread"
            description="Ask anything about your campaign and get answers grounded in what actually happened, from last session to the very beginning."
          />
        </div>
      </div>
      <p class="mt-7 text-center">
        <a
          href="/product"
          class="text-[15px] font-medium text-accent no-underline transition-opacity hover:opacity-80"
        >
          See all features &rarr;
        </a>
      </p>
    </section>

    <div class="section-connector my-12 md:my-16"></div>

    <!-- CTA Banner -->
    <div class="reveal pb-16 md:pb-24">
      <GlassCard class="p-[clamp(2.5rem,2rem+2vw,4rem)] text-center">
        <h2 class="text-[clamp(1.6rem,1.2rem+2vw,2.4rem)]">Start your next session with a recap</h2>
        <p class="mx-auto mt-4 max-w-[50ch] text-[17px] text-text-body">
          Upload your last session and see what Loremaster generates for your campaign in seconds.
        </p>
        <div class="mt-8">
          <a
            class="inline-flex items-center rounded-xl bg-accent px-10 py-[18px] text-[18px] font-semibold text-[#1a1520] no-underline transition-all duration-200 hover:-translate-y-px hover:bg-accent-hover hover:shadow-[0_4px_28px_rgba(218,160,64,0.25)]"
            href="https://app.askloremaster.com"
          >
            Try Loremaster Free
          </a>
        </div>
      </GlassCard>
    </div>
  </div>
</BaseLayout>
