---
interface Props {
  title: string;
  description: string;
  icon: string;
}

const { title, description, icon } = Astro.props;
---

<div
  class="group rounded-[14px] border border-card-border p-6 backdrop-blur-[12px] transition-all duration-200 hover:border-card-hover-border"
  style="background: var(--lm-card-glass);"
>
  <div class="mb-3 text-2xl">{icon}</div>
  <h3 class="mb-2 text-[17px] font-semibold text-text-primary">{title}</h3>
  <p class="text-[14px] leading-relaxed text-text-body">{description}</p>
</div>
