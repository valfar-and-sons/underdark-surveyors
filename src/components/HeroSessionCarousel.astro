---
const sessions = [
  {
    title: "The Stain of Brack Manor",
    date: "September 16, 2025",
    tagline: "When a job to quiet strange noises becomes a mission to cleanse a family's name, you find the real monsters aren't just in the house, but buried right outside the door.",
    image: "/static/session-brack.png",
  },
  {
    title: "Of Owls and Oysters",
    date: "September 11, 2025",
    tagline: "With one job done, a new one pulls them toward an old manor bearing a familiar name. Now they must discover what secrets are buried in the caverns below, and what makes them wail in the dark.",
    image: "/static/session-owls.png",
  },
  {
    title: "An Alliance of Salt and Steel",
    date: "September 3, 2025",
    tagline: "You find the strangest company on the road. A mad hermit, a disgraced wizard, and a cunning smuggler, all drawn together by a single rumor and bound by the blood they spilled to survive their first day.",
    image: "/static/session-alliance.png",
  },
];
---

<div>
  <div
    class="hero-carousel relative aspect-[3/4] overflow-hidden rounded-2xl sm:aspect-[4/3] md:aspect-[16/9]"
    style="box-shadow: 0 16px 48px rgba(0,0,0,0.3), 0 0 80px 8px rgba(218,160,64,0.04), 0 0 160px 20px rgba(218,160,64,0.02);"
    id="hero-carousel"
  >
    <!-- Slides (background images + bottom text rotate) -->
    {
      sessions.map((session, i) => (
        <div
          class="hero-slide absolute inset-0 transition-opacity duration-[800ms] ease-in-out"
          style={i === 0 ? "opacity: 1;" : "opacity: 0;"}
          data-index={i}
        >
          {/* Background image */}
          <img
            src={session.image}
            alt=""
            class="absolute inset-0 h-full w-full object-cover"
            style="opacity: 0.3;"
          />

          {/* Gradient overlays */}
          <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(10,9,12,0.95) 0%, rgba(10,9,12,0.7) 35%, rgba(10,9,12,0.4) 60%, rgba(10,9,12,0.3) 100%);" />
        </div>
      ))
    }

    <!-- Static header (always visible, on top of rotating backgrounds) -->
    <div class="pointer-events-none absolute inset-x-0 top-0 z-10 p-4 text-center sm:p-6 md:p-10 md:pt-12">
      <p
        class="voice-gradient text-[clamp(1.8rem,1.2rem+3vw,3rem)] font-bold leading-tight"
        style="font-family: var(--font-voice); font-style: italic;"
      >
        Previously...<br />
        <span class="text-[clamp(1.1rem,0.8rem+1.5vw,1.6rem)] font-semibold">on The Ghosts of Saltmarsh</span>
      </p>
    </div>

    <!-- Rotating bottom text (session info) -->
    {
      sessions.map((session, i) => (
        <div
          class="hero-slide-text absolute inset-x-0 bottom-0 z-10 p-4 transition-opacity duration-[800ms] ease-in-out sm:p-6 md:p-10"
          style={i === 0 ? "opacity: 1;" : "opacity: 0;"}
          data-index={i}
        >
          <p class="mb-1 text-[12px] font-medium text-text-muted md:text-[13px]">
            <svg class="mr-1.5 inline-block" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
              <line x1="16" y1="2" x2="16" y2="6" />
              <line x1="8" y1="2" x2="8" y2="6" />
              <line x1="3" y1="10" x2="21" y2="10" />
            </svg>
            {session.date}
          </p>
          <h3 class="mb-1 text-[17px] font-bold text-text-primary sm:mb-2 md:text-[26px]">
            {session.title}
          </h3>
          <p
            class="max-w-[55ch] text-[12px] leading-snug sm:text-[13px] sm:leading-relaxed md:text-[15px]"
            style="font-family: var(--font-voice); font-style: italic; color: var(--lm-voice-text); opacity: 0.8;"
          >
            {session.tagline}
          </p>
        </div>
      ))
    }

    <!-- Indicator dots -->
    <div class="absolute bottom-2 right-4 z-10 flex gap-2 sm:bottom-3 sm:right-6 md:bottom-5 md:right-10" id="hero-dots">
      {
        sessions.map((_, i) => (
          <button
            class="hero-dot h-2 rounded-full transition-all duration-300"
            style={i === 0
              ? "width: 24px; background: var(--lm-accent);"
              : "width: 8px; background: rgba(168, 158, 148, 0.4);"
            }
            data-index={i}
          />
        ))
      }
    </div>
  </div>

  <!-- Caption below -->
  <p class="mt-4 text-center text-[14px] text-text-muted">
    Generated by Loremaster from a real campaign
  </p>
</div>

<script>
  const carousel = document.getElementById("hero-carousel");
  if (carousel) {
    const slides = carousel.querySelectorAll(".hero-slide");
    const textSlides = carousel.querySelectorAll(".hero-slide-text");
    const dots = carousel.querySelectorAll(".hero-dot");
    const total = slides.length;
    let current = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    function show(index: number) {
      slides.forEach((s, i) => {
        (s as HTMLElement).style.opacity = i === index ? "1" : "0";
      });
      textSlides.forEach((s, i) => {
        (s as HTMLElement).style.opacity = i === index ? "1" : "0";
      });
      dots.forEach((d, i) => {
        const el = d as HTMLElement;
        if (i === index) {
          el.style.width = "24px";
          el.style.background = "var(--lm-accent)";
        } else {
          el.style.width = "8px";
          el.style.background = "rgba(168, 158, 148, 0.4)";
        }
      });
      current = index;
    }

    function next() {
      show((current + 1) % total);
    }

    function start() {
      if (!timer) timer = setInterval(next, 5000);
    }

    function stop() {
      if (timer) { clearInterval(timer); timer = null; }
    }

    // Click dots to jump
    dots.forEach((d) => {
      d.addEventListener("click", () => {
        stop();
        show(Number((d as HTMLElement).dataset.index));
        start();
      });
    });

    // Click to advance
    carousel.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest(".hero-dot")) return;
      stop();
      next();
      start();
    });

    // Pause on hover
    carousel.addEventListener("mouseenter", stop);
    carousel.addEventListener("mouseleave", start);

    start();
  }
</script>
