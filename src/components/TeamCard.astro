---
interface Props {
  name: string;
  title: string;
  bio: string;
}

const { name, title, bio } = Astro.props;
---

<div
  class="rounded-xl border border-card-border p-5 backdrop-blur-[8px] transition-all duration-200 hover:border-card-hover-border"
  style="background: var(--lm-surface-glass);"
>
  <p class="mb-1 text-[15px] font-semibold text-text-primary">
    {name}
  </p>
  <p class="mb-2 text-[13px] font-medium text-accent">{title}</p>
  <p class="text-[14px] leading-relaxed text-text-muted">{bio}</p>
</div>
