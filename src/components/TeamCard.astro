---
interface Props {
  name: string;
  title: string;
  bio: string;
}

const { name, title, bio } = Astro.props;
---

<div
  class="rounded-xl border border-card-border p-7 md:p-8 backdrop-blur-[8px] transition-all duration-200 hover:border-card-hover-border"
  style="background: var(--lm-surface-glass);"
>
  <p class="mb-1.5 text-[18px] font-semibold text-text-primary md:text-[19px]">
    {name}
  </p>
  <p class="mb-3 text-[14px] font-medium text-accent md:text-[15px]">{title}</p>
  <p class="text-[15px] leading-relaxed text-text-muted md:text-[16px]">{bio}</p>
</div>
