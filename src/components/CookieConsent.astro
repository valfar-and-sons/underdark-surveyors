---
// Cookie consent card: a small panel pinned to the bottom of the viewport.
//
// Opt-out model: analytics runs by default and this card lets the visitor
// confirm or turn it off. Categories are data-driven below. Today there is
// one optional category, analytics. Add another entry (and a matching key
// in BaseLayout's consent script) only when something actually consumes it.
//
// It never blocks the page. There is no backdrop and no modal; the site
// stays fully readable and clickable behind it. "Manage preferences"
// expands a second layer inside the same card rather than opening a dialog.
//
// Consent state (window.lmConsent) and the Google Consent Mode wiring live in
// the inline script in BaseLayout's <head>, so defaults are queued before any
// tag can run. This component is only the UI and talks to that object.
//
// The card renders hidden. The inline script at the bottom reveals it only
// when no valid choice is stored, so returning visitors never see a flash.

const categories = [
  {
    key: "necessary",
    label: "Strictly necessary",
    status: "Always on",
    locked: true,
    description:
      "Required for the site to function, such as remembering this choice and whether you are signed in to the app. These can't be turned off.",
  },
  {
    key: "analytics",
    label: "Analytics",
    status: "On",
    locked: false,
    description:
      "Help us see which pages people visit and how the site performs, so we can improve it. Currently Google Analytics. On by default; turn it off any time.",
  },
];

// Accept and Reject share one style on purpose: a refusal has to be as easy
// and as visible as an acceptance.
const btnChoice =
  "inline-flex items-center justify-center rounded-[10px] border border-accent/50 bg-accent/10 px-4 py-2.5 text-[14px] font-semibold text-accent no-underline transition-all duration-200 hover:-translate-y-px hover:border-accent hover:bg-accent/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent";
const btnGhost =
  "inline-flex items-center justify-center rounded-[10px] px-3 py-2.5 text-[14px] font-semibold text-text-body no-underline transition-colors duration-200 hover:text-text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent";
const link =
  "text-accent underline decoration-accent/30 underline-offset-2 transition-colors hover:decoration-accent";
---

<section
  id="cookie-consent"
  class="cookie-card fixed inset-x-4 bottom-4 z-[60] mx-auto max-h-[calc(100dvh-2rem)] max-w-[520px] overflow-y-auto rounded-[14px] border border-card-border shadow-[0_20px_60px_rgba(0,0,0,0.5)] backdrop-blur-[12px] md:inset-x-auto md:right-6 md:bottom-6"
  style="background: var(--lm-card-glass); border-top: 1px solid var(--lm-card-border-top);"
  aria-label="Cookie consent"
  hidden
>
  <div class="relative p-5 md:p-6">
    <button
      type="button"
      class="absolute top-3 right-3 inline-flex h-8 w-8 items-center justify-center rounded-full text-text-muted transition-colors hover:bg-white/10 hover:text-text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      aria-label="Close cookie settings"
      data-consent-action="close"
      hidden
    >
      <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M5 5l10 10M15 5L5 15" />
      </svg>
    </button>

    <!-- First layer -->
    <div data-consent-layer="summary">
      <h2 class="mb-1.5 pr-8 text-[17px] font-semibold text-text-primary">We use cookies</h2>
      <p class="mb-2 text-[14px] leading-relaxed text-text-body">
        Some are required to make the site work. Others help us understand how people use
        Loremaster. You can turn those off now or change your mind any time.
      </p>
      <p class="mb-4 text-[13px] text-text-muted">
        <a href="/privacy#cookies" class={link}>Learn more in our Privacy Policy</a>
      </p>
      <div class="flex flex-wrap items-center gap-2.5">
        <button type="button" class={btnChoice} data-consent-action="accept">Accept all</button>
        <button type="button" class={btnChoice} data-consent-action="reject">Reject all</button>
        <button type="button" class={btnGhost} data-consent-action="manage">Manage preferences</button>
      </div>
    </div>

    <!-- Second layer -->
    <div data-consent-layer="preferences" hidden>
      <h2 class="mb-1.5 pr-8 text-[17px] font-semibold text-text-primary">Cookie preferences</h2>
      <p class="mb-4 text-[14px] leading-relaxed text-text-body">
        Choose which cookies Loremaster may set. Analytics is on unless you turn it off.
      </p>

      <ul class="mb-5 grid gap-2.5">
        {
          categories.map((cat) => (
            <li class="flex items-start justify-between gap-4 rounded-[10px] border border-divider bg-white/[0.02] px-4 py-3">
              <div>
                <p class="mb-0.5 flex items-baseline gap-2 text-[14px] font-semibold text-text-primary">
                  {cat.locked ? (
                    <span id={`consent-${cat.key}-label`}>{cat.label}</span>
                  ) : (
                    <label for={`consent-${cat.key}`}>{cat.label}</label>
                  )}
                  <span
                    class="text-[12px] font-medium text-text-muted"
                    data-consent-status={cat.key}
                  >
                    {cat.status}
                  </span>
                </p>
                <p id={`consent-${cat.key}-desc`} class="text-[13px] leading-relaxed text-text-body">
                  {cat.description}
                </p>
              </div>
              {cat.locked ? (
                <span
                  class="consent-switch is-locked"
                  role="switch"
                  aria-checked="true"
                  aria-disabled="true"
                  aria-labelledby={`consent-${cat.key}-label`}
                  aria-describedby={`consent-${cat.key}-desc`}
                />
              ) : (
                <button
                  type="button"
                  id={`consent-${cat.key}`}
                  class="consent-switch"
                  role="switch"
                  aria-checked="false"
                  aria-describedby={`consent-${cat.key}-desc`}
                  data-consent-category={cat.key}
                />
              )}
            </li>
          ))
        }
      </ul>

      <div class="flex flex-wrap items-center gap-2.5">
        <button type="button" class={btnChoice} data-consent-action="save">Save preferences</button>
        <button type="button" class={btnChoice} data-consent-action="accept">Accept all</button>
        <button type="button" class={btnChoice} data-consent-action="reject">Reject all</button>
      </div>
    </div>
  </div>
</section>

<style>
  .cookie-card {
    animation: cookieCardIn 360ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  @keyframes cookieCardIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .consent-switch {
    position: relative;
    flex: none;
    width: 42px;
    height: 24px;
    margin-top: 2px;
    border-radius: 999px;
    border: 1px solid var(--lm-chat-input-border);
    background: rgba(255, 255, 255, 0.08);
    cursor: pointer;
    padding: 0;
    transition:
      background 200ms ease,
      border-color 200ms ease;
  }

  .consent-switch::after {
    content: "";
    position: absolute;
    top: 3px;
    left: 3px;
    width: 16px;
    height: 16px;
    border-radius: 999px;
    background: var(--lm-text-body);
    transition:
      transform 200ms ease,
      background 200ms ease;
  }

  .consent-switch[aria-checked="true"] {
    background: var(--lm-accent);
    border-color: var(--lm-accent);
  }

  .consent-switch[aria-checked="true"]::after {
    transform: translateX(18px);
    background: #1a1520;
  }

  .consent-switch.is-locked {
    cursor: default;
    opacity: 0.7;
  }

  .consent-switch:focus-visible {
    outline: 2px solid var(--lm-accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .cookie-card {
      animation: none;
    }
    .consent-switch,
    .consent-switch::after {
      transition: none;
    }
  }
</style>

<script is:inline>
  (function () {
    var consent = window.lmConsent;
    var card = document.getElementById("cookie-consent");
    if (!consent || !card) return;

    var summary = card.querySelector('[data-consent-layer="summary"]');
    var preferences = card.querySelector('[data-consent-layer="preferences"]');
    var closeButton = card.querySelector('[data-consent-action="close"]');
    var switches = Array.prototype.slice.call(
      card.querySelectorAll("[data-consent-category]"),
    );

    function setSwitch(el, on) {
      el.setAttribute("aria-checked", on ? "true" : "false");
      var status = card.querySelector(
        '[data-consent-status="' + el.getAttribute("data-consent-category") + '"]',
      );
      if (status) status.textContent = on ? "On" : "Off";
    }

    function readSwitches() {
      var choices = {};
      switches.forEach(function (el) {
        choices[el.getAttribute("data-consent-category")] =
          el.getAttribute("aria-checked") === "true";
      });
      return choices;
    }

    function show(layer) {
      var stored = consent.get();
      summary.hidden = layer !== "summary";
      preferences.hidden = layer !== "preferences";
      // The close control only appears once a choice is on record. Before
      // that, the three explicit buttons are the only way to dismiss the card.
      closeButton.hidden = !stored;
      card.hidden = false;
      if (layer === "preferences") {
        var current = consent.current();
        switches.forEach(function (el) {
          setSwitch(el, !!current[el.getAttribute("data-consent-category")]);
        });
        var first = switches[0];
        if (first) first.focus({ preventScroll: true });
      }
    }

    function hide() {
      card.hidden = true;
    }

    function decide(choices) {
      consent.set(choices);
      hide();
    }

    document.addEventListener("click", function (event) {
      var target = event.target instanceof Element ? event.target : null;
      if (!target) return;

      // The footer "Cookie Settings" link reopens the preferences layer from
      // anywhere on the site.
      if (target.closest('a[href="#cookie-settings"]')) {
        event.preventDefault();
        show("preferences");
        return;
      }

      var action = target.closest("[data-consent-action]");
      if (action && card.contains(action)) {
        switch (action.getAttribute("data-consent-action")) {
          case "accept":
            decide({ analytics: true });
            break;
          case "reject":
            decide({ analytics: false });
            break;
          case "manage":
            show("preferences");
            break;
          case "save":
            decide(readSwitches());
            break;
          case "close":
            hide();
            break;
        }
        return;
      }

      var toggle = target.closest("[data-consent-category]");
      if (toggle && card.contains(toggle)) {
        setSwitch(toggle, toggle.getAttribute("aria-checked") !== "true");
      }
    });

    // Escape closes the card only when a choice already exists.
    card.addEventListener("keydown", function (event) {
      if (event.key === "Escape" && consent.get()) hide();
    });

    if (!consent.get()) show("summary");
  })();
</script>
