---
const columns = [
  {
    title: "Loremaster",
    links: [
      { href: "/product", label: "What is Loremaster" },
      { href: "/pricing", label: "Pricing" },
      { href: "https://loremaster.valfarandsons.com", label: "Try Loremaster", external: true },
      // { href: "/changelog", label: "Changelog" },
    ],
  },
  {
    title: "Legal",
    links: [
      { href: "/privacy", label: "Privacy Policy" },
      { href: "/terms", label: "Terms of Service" },
      { href: "/subprocessors", label: "Subprocessors" },
    ],
  },
  {
    title: "Company",
    links: [
      { href: "/about", label: "About Us" },
      { href: "mailto:contact@valfarandsons.com", label: "Contact" },
      // { href: "/blog", label: "Blog" },
      // { href: "/careers", label: "Careers" },
    ],
  },
];
---

<footer class="relative z-10 mt-16 border-t border-divider">
  <div class="mx-auto max-w-[1200px] px-[clamp(16px,4vw,28px)] py-12">
    <!-- Top: Brand + Columns -->
    <div class="grid gap-10 md:grid-cols-[1.5fr_1fr_1fr_1fr]">
      <!-- Brand column -->
      <div>
        <a href="/" class="mb-3 flex items-center gap-2.5 no-underline">
          <img
            class="block h-8 w-8 rounded-lg object-cover"
            src="/static/loremaster-logo.png"
            alt="Loremaster logo"
            width="32"
            height="32"
          />
          <span class="text-[14px] font-semibold text-text-primary">Loremaster</span>
        </a>
        <p class="mt-2 max-w-[28ch] text-[13px] leading-relaxed text-text-muted">
          AI-powered tools for tabletop storytelling.
        </p>
      </div>

      <!-- Link columns -->
      {
        columns.map((col) => (
          <div>
            <h4 class="mb-3 text-[13px] font-semibold tracking-wide text-text-body uppercase">
              {col.title}
            </h4>
            <ul class="grid gap-2">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-[13px] text-text-muted no-underline transition-colors duration-200 hover:text-text-primary"
                    {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!-- Bottom bar -->
    <div class="mt-10 border-t border-divider pt-6">
      <p class="text-[12px] text-text-faint">
        &copy; 2026 Valfar and Sons, Inc. All rights reserved.
      </p>
    </div>
  </div>
</footer>
