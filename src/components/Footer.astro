---
const columns = [
  {
    title: "Loremaster",
    links: [
      { href: "/product", label: "What is Loremaster" },
      { href: "/faq", label: "FAQ" },
      { href: "https://app.askloremaster.com/waitlist", label: "Request Early Access" },
      // { href: "/changelog", label: "Changelog" },
    ],
  },
  {
    title: "Legal",
    links: [
      { href: "/privacy", label: "Privacy Policy" },
      { href: "/terms", label: "Terms of Service" },
      { href: "/subprocessors", label: "Subprocessors" },
    ],
  },
  {
    title: "Company",
    links: [
      { href: "/about", label: "About Us" },
      { href: "mailto:contact@valfarandsons.com", label: "Contact" },
      // { href: "/blog", label: "Blog" },
      // { href: "/careers", label: "Careers" },
    ],
  },
];
---

<footer class="relative z-10 mt-16 border-t border-divider">
  <div class="mx-auto max-w-[1200px] px-[clamp(16px,4vw,28px)] py-12">
    <!-- Top: Brand + Columns -->
    <div class="grid gap-10 md:grid-cols-[1.5fr_1fr_1fr_1fr]">
      <!-- Brand column -->
      <div>
        <a href="/" class="mb-3 flex items-center gap-2.5 no-underline">
          <img
            class="block h-8 w-8 rounded-lg object-cover"
            src="/static/loremaster-logo.png"
            alt="Loremaster logo"
            width="32"
            height="32"
          />
          <span class="text-[19px] font-bold leading-none text-text-primary" style="margin-bottom: 2px;">Loremaster</span>
        </a>
        <p class="mt-2 max-w-[28ch] text-[13px] leading-relaxed text-text-muted">
          AI-powered tools for tabletop storytelling.
        </p>
        <a
          href="https://discord.gg/YJjqmzy9Vv"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center gap-1.5 text-[13px] text-text-muted no-underline transition-colors duration-200 hover:text-text-primary"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.095 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.095 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
          </svg>
          Join our Discord
        </a>
      </div>

      <!-- Link columns -->
      {
        columns.map((col) => (
          <div>
            <h4 class="mb-3 text-[13px] font-semibold tracking-wide text-text-body uppercase">
              {col.title}
            </h4>
            <ul class="grid gap-2">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-[13px] text-text-muted no-underline transition-colors duration-200 hover:text-text-primary"
                    {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!-- Bottom bar -->
    <div class="mt-10 border-t border-divider pt-6">
      <p class="text-center text-[12px] text-text-faint">
        &copy; 2026 Valfar and Sons, Inc. All rights reserved.
      </p>
    </div>
  </div>
</footer>
